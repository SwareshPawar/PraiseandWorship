# Environment Variables for Praise and Worship App
# Configure these in your Vercel project settings under Environment Variables

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
PORT=3001
OLDANDNEW_BASE_URL=https://oldand-new.vercel.app
OLDANDNEW_RHYTHM_SETS_URL=https://oldand-new.vercel.app/api/rhythm-sets
# Optional auth for external rhythm-set notes sync (endpoint is typically protected)
OLDANDNEW_AUTH_TOKEN=
# Alternative: mint a temporary Bearer token locally from the external app's JWT secret
OLDANDNEW_JWT_SECRET=
OLDANDNEW_AUTH_USER_ID=external-notes-sync
OLDANDNEW_AUTH_USERNAME=external-notes-sync
OLDANDNEW_AUTH_EMAIL=external-notes-sync@local.invalid
OLDANDNEW_AUTH_IS_ADMIN=true
OLDANDNEW_AUTH_EXPIRES_IN=15m
# Optional full payload override as JSON
OLDANDNEW_AUTH_PAYLOAD_JSON=
# Optional custom auth header (if external source uses non-Bearer auth)
OLDANDNEW_AUTH_HEADER_NAME=
OLDANDNEW_AUTH_HEADER_VALUE=

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890