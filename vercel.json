{
  "version": 2,
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/api/songs/?(.*)",
      "dest": "/api/songs.js"
    },
    {
      "src": "/api/userdata",
      "dest": "/api/userdata.js"
    },
    {
      "src": "/api/register",
      "dest": "/api/register.js"
    },
    {
      "src": "/api/login",
      "dest": "/api/login.js"
    },
    {
      "src": "/api/forgot-password",
      "dest": "/api/forgot-password.js"
    },
    {
      "src": "/api/reset-password",
      "dest": "/api/reset-password.js"
    },
    {
      "src": "/api/recommendation-weights",
      "dest": "/api/recommendation-weights.js"
    },
    {
      "src": "/api/users/?(.*)",
      "dest": "/api/users.js"
    },
    {
      "src": "/api/global-setlists/?(.*)",
      "dest": "/api/global-setlists.js"
    },
    {
      "src": "/api/my-setlists/?(.*)",
      "dest": "/api/my-setlists.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Content-Type", 
          "value": "application/javascript"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options", 
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}